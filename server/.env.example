AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# This recipe is BYO-only: EVERY realtime MLLM vendor requires its own key.
# Pick one with REALTIME_VENDOR (default: openai) and set that vendor's creds below.
REALTIME_VENDOR=openai
# AGENT_GREETING=Hi! I'm a realtime voice assistant — let's just talk.

# --- Vendor credentials (set the block for the REALTIME_VENDOR you selected) ---

# openai  (default; model gpt-realtime)
OPENAI_API_KEY=your-openai-realtime-key
# OPENAI_REALTIME_MODEL=gpt-realtime

# openai_gpt_live  (model gpt-live-1; reuses OPENAI_API_KEY)
# REALTIME_VENDOR=openai_gpt_live
# OPENAI_GPT_LIVE_MODEL=gpt-live-1

# azure  (requires the complete Azure Realtime WebSocket URL and deployment name)
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_REALTIME_URL=wss://your-resource.openai.azure.com/openai/realtime
# AZURE_OPENAI_REALTIME_MODEL=your-azure-deployment-or-model-name

# gemini  (model models/gemini-3.8-live)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_LIVE_MODEL=models/gemini-3.8-live
# For models/gemini-3.8-live-extended-thinking only: low, medium, or high.
# GEMINI_THINKING_LEVEL=high

# xai  (Grok realtime)
# XAI_API_KEY=your-xai-api-key

# vertexai  (model gemini-2.0-flash-live-001)
# GOOGLE_APPLICATION_CREDENTIALS_JSON=your-adc-credentials-json
# GOOGLE_PROJECT_ID=your-gcp-project-id
# GOOGLE_LOCATION=us-central1
# VERTEXAI_REALTIME_MODEL=gemini-2.0-flash-live-001
